// Benchmark: longest Collatz chain for starting values 1..N.
// Pure int arithmetic, while loops, conditionals. No arrays.
// Output: starting number that produces the longest chain.

let N = 1000000
let best_start = 1
let best_len = 1

let n = 2
while n <= N {
    let current = n
    let chain_len = 1
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2
        } else {
            current = current * 3 + 1
        }
        chain_len += 1
    }
    if chain_len > best_len {
        best_len = chain_len
        best_start = n
    }
    n += 1
}
show(to_string(best_start))
