// Benchmark: map/filter/reduce pipeline with closures.
// Tests: higher-order function overhead, callback invocation, intermediate
// array allocation, typed-array-to-generic conversion.
// Output: accumulated sum checksum.

let data = range(10000)
let total = 0
let round = 0
while round < 100 {
    let doubled = map(data, (x int) int { return x * 2 })
    let evens = filter(doubled, (x int) boolean { return x % 4 == 0 })
    let sum = reduce(evens, (acc int, x int) int { return acc + x }, 0)
    total += sum
    round += 1
}
show(to_string(total))
