// Benchmark: N-body gravitational simulation (5 planets).
// Parallel float[] arrays (SoA layout). sqrt in hot loop.
// Tests: typed float[] element access, math builtins, nested loops.
// Output: final energy * 1e9 truncated to integer.

let PI = 3.141592653589793
let SOLAR_MASS = 4.0 * PI * PI
let DAYS_PER_YEAR = 365.24
let N = 5
let STEPS = 500000
let DT = 0.01

// Sun, Jupiter, Saturn, Uranus, Neptune
let x = [0.0, 4.84143144246472090, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165]
let y = [0.0, -1.16032004402742839, 4.12479856412430479, -15.1111514016986312, -25.9193146099879641]
let z = [0.0, -0.103622044471123109, -0.403523417114321381, -0.223307578892655734, 0.179258772950371181]

let vx = [0.0, 0.00166007664274403694 * DAYS_PER_YEAR, -0.00276742510726862411 * DAYS_PER_YEAR, 0.00296460137564761618 * DAYS_PER_YEAR, 0.00268067772490389322 * DAYS_PER_YEAR]
let vy = [0.0, 0.00769901118419740425 * DAYS_PER_YEAR, 0.00499852801234917238 * DAYS_PER_YEAR, 0.00237847173959480950 * DAYS_PER_YEAR, 0.00162824170038242295 * DAYS_PER_YEAR]
let vz = [0.0, -0.0000690460016972063023 * DAYS_PER_YEAR, 0.0000230417297573763929 * DAYS_PER_YEAR, -0.0000296589568540237556 * DAYS_PER_YEAR, -0.0000951592254519715870 * DAYS_PER_YEAR]

let mass = [SOLAR_MASS, 0.000954791938424326609 * SOLAR_MASS, 0.000285885980666130812 * SOLAR_MASS, 0.0000436624404335156298 * SOLAR_MASS, 0.0000515138902046611451 * SOLAR_MASS]

// Offset momentum
let px = 0.0
let py = 0.0
let pz = 0.0
let i = 0
while i < N {
    px += vx[i] * mass[i]
    py += vy[i] * mass[i]
    pz += vz[i] * mass[i]
    i += 1
}
vx[0] = 0.0 - px / SOLAR_MASS
vy[0] = 0.0 - py / SOLAR_MASS
vz[0] = 0.0 - pz / SOLAR_MASS

// Advance
let step = 0
while step < STEPS {
    i = 0
    while i < N {
        let j = i + 1
        while j < N {
            let dx = x[i] - x[j]
            let dy = y[i] - y[j]
            let dz = z[i] - z[j]
            let dist2 = dx * dx + dy * dy + dz * dz
            let dist = sqrt(dist2)
            let mag = DT / (dist2 * dist)
            vx[i] = vx[i] - dx * mass[j] * mag
            vy[i] = vy[i] - dy * mass[j] * mag
            vz[i] = vz[i] - dz * mass[j] * mag
            vx[j] = vx[j] + dx * mass[i] * mag
            vy[j] = vy[j] + dy * mass[i] * mag
            vz[j] = vz[j] + dz * mass[i] * mag
            j += 1
        }
        i += 1
    }
    i = 0
    while i < N {
        x[i] = x[i] + DT * vx[i]
        y[i] = y[i] + DT * vy[i]
        z[i] = z[i] + DT * vz[i]
        i += 1
    }
    step += 1
}

// Compute energy
let e = 0.0
i = 0
while i < N {
    e = e + 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
    let j = i + 1
    while j < N {
        let dx = x[i] - x[j]
        let dy = y[i] - y[j]
        let dz = z[i] - z[j]
        let dist = sqrt(dx * dx + dy * dy + dz * dz)
        e = e - mass[i] * mass[j] / dist
        j += 1
    }
    i += 1
}
show(to_string(to_int(e * 1000000000.0)))
