// Benchmark: Sieve of Eratosthenes, count primes up to N.
// Array-heavy: allocate, index-write in nested loops.
// Output: count of primes up to N (integer checksum).

let N = 1000000
let is_prime = range(N + 1)

let i = 0
while i <= N {
    is_prime[i] = 1
    i += 1
}
is_prime[0] = 0
is_prime[1] = 0

i = 2
while i * i <= N {
    if is_prime[i] == 1 {
        let j = i * i
        while j <= N {
            is_prime[j] = 0
            j += i
        }
    }
    i += 1
}

let count = 0
i = 2
while i <= N {
    if is_prime[i] == 1 {
        count += 1
    }
    i += 1
}
show(to_string(count))
