{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Monk",
  "scopeName": "source.monk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-literals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#function-declaration" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.monk",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.monk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.monk",
          "match": "\\\\[\\\\\"nrt0]"
        }
      ]
    },
    "template-literals": {
      "name": "string.template.monk",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.monk",
          "match": "\\\\[\\\\`nrt0]"
        },
        {
          "name": "meta.template.expression.monk",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.monk" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.monk" }
          },
          "patterns": [
            { "include": "source.monk" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.monk",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.scientific.monk",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.hex.monk",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.monk",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.monk",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.decimal.monk",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.monk",
          "match": "\\b(if|else|for|in|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.control.error.monk",
          "match": "\\b(guard|against|throw)\\b"
        },
        {
          "name": "keyword.control.module.monk",
          "match": "\\b(use|export|from|as)\\b"
        },
        {
          "name": "storage.type.monk",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "keyword.other.type.monk",
          "match": "\\b(type)\\b"
        },
        {
          "name": "keyword.operator.logical.monk",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.monk",
          "match": "\\b(int|float|string|boolean|none)\\b"
        },
        {
          "name": "entity.name.type.monk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.monk",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.monk",
          "match": "\\b(none)\\b"
        },
        {
          "name": "variable.other.constant.monk",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Output and conversion",
          "name": "support.function.builtin.monk",
          "match": "\\b(show|to_string|to_int|to_float)\\b(?=\\s*\\()"
        },
        {
          "comment": "Type checking",
          "name": "support.function.builtin.monk",
          "match": "\\b(typeof|is_number|is_string|is_boolean|is_array|is_record|is_function|is_none)\\b(?=\\s*\\()"
        },
        {
          "comment": "String operations",
          "name": "support.function.builtin.monk",
          "match": "\\b(length|substring|index_of|split|trim|to_upper_case|to_lower_case)\\b(?=\\s*\\()"
        },
        {
          "comment": "Array operations",
          "name": "support.function.builtin.monk",
          "match": "\\b(append|prepend|pop|drop|take|slice|range)\\b(?=\\s*\\()"
        },
        {
          "comment": "Math functions",
          "name": "support.function.builtin.monk",
          "match": "\\b(abs|floor|ceil|round|sqrt|pow|log|log10|exp|min|max|sin|cos|tan|asin|acos|atan)\\b(?=\\s*\\()"
        },
        {
          "comment": "File I/O and environment",
          "name": "support.function.builtin.monk",
          "match": "\\b(file_read|file_write|file_exists|env_get|exit|args)\\b(?=\\s*\\()"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "comment": "let/const name = (...) type { ... }",
          "match": "\\b(let|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.monk" },
            "2": { "name": "entity.name.function.monk" }
          }
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.monk" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.monk",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.monk",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.monk",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.monk",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.monk",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.symbol.monk",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.monk",
          "match": "<<|>>|&|\\||\\^|~"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.monk",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.monk",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.group.monk",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.monk",
          "match": "[,:]"
        },
        {
          "name": "punctuation.accessor.monk",
          "match": "\\."
        }
      ]
    },
    "variables": {
      "name": "variable.other.monk",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
