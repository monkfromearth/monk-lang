// Sieve of Eratosthenes — find all primes up to N.
// Demonstrates: arrays, index mutation, nested loops, break/continue.

let N = 100

// 0 = composite, 1 = prime (using int since we don't have bool arrays yet)
let is_prime = range(N + 1)
let i = 0
while i <= N {
    is_prime[i] = 1
    i += 1
}
is_prime[0] = 0
is_prime[1] = 0

// Sieve: mark multiples of each prime as composite
i = 2
while i * i <= N {
    if is_prime[i] == 1 {
        let j = i * i
        while j <= N {
            is_prime[j] = 0
            j += i
        }
    }
    i += 1
}

// Collect primes
let primes = []
i = 2
while i <= N {
    if is_prime[i] == 1 {
        primes = append(primes, i)
    }
    i += 1
}

show("Primes up to " + to_string(N) + ": " + to_string(primes))
show("Count: " + to_string(length(primes)))

// ─── Twin primes ───────────────────────────────────────────────────────────
// Twin primes are pairs (p, p+2) where both are prime.

show("")
show("Twin primes up to " + to_string(N) + ":")
i = 0
while i < length(primes) - 1 {
    let p = primes[i]
    let q = primes[i + 1]
    if q - p == 2 {
        show("  (" + to_string(p) + ", " + to_string(q) + ")")
    }
    i += 1
}
