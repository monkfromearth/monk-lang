---
/**
 * Small colored tag pill.
 */
interface Props {
  variant: 'concepts' | 'zig' | 'go' | 'monk' | 'exercise' | 'build' | 'links' | 'c' | 'types' | 'default';
}

const { variant = 'default' } = Astro.props;

const variantClasses: Record<string, string> = {
  concepts: 'text-monk-muted bg-stone-100',
  zig: 'text-monk-blue bg-monk-blueLight',
  go: 'text-monk-blue bg-monk-blueLight',
  monk: 'text-monk-accent bg-monk-accentLight',
  exercise: 'text-monk-green bg-monk-greenLight',
  build: 'text-monk-green bg-monk-greenLight',
  links: 'text-monk-muted bg-stone-100',
  c: 'text-monk-amber bg-monk-amberLight',
  types: 'text-sky-600 bg-sky-50',
  default: 'text-monk-muted bg-stone-100',
};
---

<span class={`tag px-2 py-0.5 rounded-full ${variantClasses[variant] || variantClasses.default}`}>
    <slot />
</span>
