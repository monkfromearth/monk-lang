---
import '../styles/global.css';
import TagBadge from '../components/TagBadge.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Building Monk Lang — The Learning Journey</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="font-sans text-monk-text min-h-screen">

    <header class="border-b border-monk-border bg-white/80 backdrop-blur-sm sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-monk-accent rounded-lg flex items-center justify-center">
                    <span class="text-white font-bold text-sm">M</span>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-none">Building Monk Lang</h1>
                    <p class="text-monk-muted text-xs mt-0.5">The Learning Journey</p>
                </div>
            </div>
            <div class="flex items-center gap-4 text-sm text-monk-muted">
                <span>9 units</span>
                <span class="text-monk-border">|</span>
                <span>30 lessons</span>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10">

        <!-- Hero -->
        <section class="mb-14">
            <h2 class="text-3xl font-extrabold tracking-tight mb-3">Build a programming language from scratch.</h2>
            <p class="text-monk-muted text-lg max-w-2xl leading-relaxed">
                You'll go from zero to a working compiler that produces native binaries.
                Along the way, you'll learn compiler design, C, and how programming languages actually work.
            </p>

            <!-- Pipeline Visualization -->
            <div class="mt-10 bg-white rounded-2xl border border-monk-border p-8">
                <div class="pipeline-grid">
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-monk-accentLight border border-monk-accent/20 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-monk-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-monk-accent">Source</div>
                        <code class="text-[10px] font-mono text-monk-muted">.monk</code>
                    </div>
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-monk-blueLight border border-blue-200 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-monk-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-monk-blue">Lexer</div>
                        <code class="text-[10px] font-mono text-monk-muted">tokens</code>
                    </div>
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-monk-tealLight border border-teal-200 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-monk-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-monk-teal">Parser</div>
                        <code class="text-[10px] font-mono text-monk-muted">AST</code>
                    </div>
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-monk-greenLight border border-green-200 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-monk-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-monk-green">Checker</div>
                        <code class="text-[10px] font-mono text-monk-muted">typed AST</code>
                    </div>
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-monk-amberLight border border-amber-200 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-monk-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384-3.19A.75.75 0 005.25 12.5v6.375a.75.75 0 00.786.737l5.384-.319a.75.75 0 00.58-.736V15.17zm0 0l5.384-3.19m0 0a.75.75 0 00-.58-.737l-5.384-.319a.75.75 0 00-.786.737v6.375m6.75-6.056V6a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6v6.375"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-monk-amber">Codegen</div>
                        <code class="text-[10px] font-mono text-monk-muted">.c file</code>
                    </div>
                    <div class="pipeline-node fade-in">
                        <div class="w-16 h-16 mx-auto rounded-xl bg-stone-100 border border-stone-300 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z"/></svg>
                        </div>
                        <div class="font-semibold text-sm text-stone-600">Binary</div>
                        <code class="text-[10px] font-mono text-monk-muted">native</code>
                    </div>
                </div>
            </div>
        </section>

        <!-- Course Map -->
        <section>

            <!-- Unit 0: Foundations -->
            <div class="mb-10">
                <div class="flex items-center gap-2 mb-4">
                    <TagBadge variant="monk">Foundations</TagBadge>
                    <span class="text-monk-muted text-sm">Before you write any compiler code</span>
                </div>

                <div class="unit-card bg-white rounded-2xl border border-monk-border overflow-hidden">
                    <div class="p-6 border-b border-monk-border bg-gradient-to-r from-monk-accentLight to-white">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="font-bold text-xl">Unit 0 — The Ground Floor</h3>
                                <p class="text-monk-muted mt-1">How compilers work. Project setup. Then we build.</p>
                            </div>
                            <span class="tag text-monk-accent bg-white px-2 py-0.5 rounded-full border border-monk-accent/20">2 lessons</span>
                        </div>
                    </div>
                    <div class="divide-y divide-monk-border">
                        <a href="/foundations/how-compilers-work" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-accentLight flex items-center justify-center flex-shrink-0">
                                <span class="text-monk-accent font-semibold text-sm">0.1</span>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-semibold text-sm">How Compilers Work</h4>
                                <p class="text-monk-muted text-xs mt-0.5">The 10-minute mental model. Source to binary, step by step.</p>
                            </div>
                            <TagBadge variant="concepts">concepts</TagBadge>
                        </a>
                        <a href="/foundations/setting-up" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-accentLight flex items-center justify-center flex-shrink-0">
                                <span class="text-monk-accent font-semibold text-sm">0.2</span>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-semibold text-sm">Setting Up</h4>
                                <p class="text-monk-muted text-xs mt-0.5">Install Go, create the project, run your first test.</p>
                            </div>
                            <TagBadge variant="exercise">exercise</TagBadge>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Unit 1: Lexer -->
            <div class="mb-10">
                <div class="flex items-center gap-2 mb-4">
                    <span class="tag text-monk-blue bg-monk-blueLight px-2 py-0.5 rounded-full">Phase 1</span>
                    <span class="text-monk-muted text-sm">Build the tokenizer</span>
                </div>

                <div class="unit-card bg-white rounded-2xl border border-monk-border overflow-hidden">
                    <div class="p-6 border-b border-monk-border bg-gradient-to-r from-monk-blueLight to-white">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="font-bold text-xl">Unit 1 — The Lexer</h3>
                                <p class="text-monk-muted mt-1">Break source code into tokens. Characters in, meaningful chunks out.</p>
                            </div>
                            <span class="tag text-monk-blue bg-white px-2 py-0.5 rounded-full border border-blue-200">4 lessons</span>
                        </div>
                    </div>
                    <div class="divide-y divide-monk-border">
                        <a href="/phase-1-lexer/what-is-a-lexer" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-blueLight flex items-center justify-center flex-shrink-0"><span class="text-monk-blue font-semibold text-sm">1.1</span></div>
                            <div class="flex-1"><h4 class="font-semibold text-sm">What Is a Lexer?</h4><p class="text-monk-muted text-xs mt-0.5">Characters flow in, tokens flow out. The word splitter.</p></div>
                            <TagBadge variant="concepts">concepts</TagBadge>
                        </a>
                        <a href="/phase-1-lexer/monks-tokens" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-blueLight flex items-center justify-center flex-shrink-0"><span class="text-monk-blue font-semibold text-sm">1.2</span></div>
                            <div class="flex-1"><h4 class="font-semibold text-sm">Designing Monk's Token Set</h4><p class="text-monk-muted text-xs mt-0.5">Every keyword, operator, delimiter mapped to a token type.</p></div>
                            <TagBadge variant="monk">monk</TagBadge>
                        </a>
                        <a href="/phase-1-lexer/building-the-lexer" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-blueLight flex items-center justify-center flex-shrink-0"><span class="text-monk-blue font-semibold text-sm">1.3</span></div>
                            <div class="flex-1"><h4 class="font-semibold text-sm">Building the Lexer</h4><p class="text-monk-muted text-xs mt-0.5">Step by step: scanning, keywords, literals, line tracking. TDD.</p></div>
                            <div class="flex gap-1.5"><TagBadge variant="build">build</TagBadge></div>
                        </a>
                        <a href="/phase-1-lexer/references" class="lesson-item flex items-center gap-4 px-6 py-4 cursor-pointer">
                            <div class="w-8 h-8 rounded-full bg-monk-blueLight flex items-center justify-center flex-shrink-0"><span class="text-monk-blue font-semibold text-sm">1.4</span></div>
                            <div class="flex-1"><h4 class="font-semibold text-sm">References & Further Reading</h4><p class="text-monk-muted text-xs mt-0.5">Crafting Interpreters Ch. 4, lexer blog posts.</p></div>
                            <TagBadge variant="links">links</TagBadge>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Unit 2: Parser -->
            <div class="mb-10">
                <div class="flex items-center gap-2 mb-4">
                    <span class="tag text-monk-teal bg-monk-tealLight px-2 py-0.5 rounded-full">Phase 2</span>
                    <span class="text-monk-muted text-sm">Build the parser</span>
                </div>

                <div class="unit-card bg-white rounded-2xl border border-monk-border overflow-hidden">
                    <div class="p-6 border-b border-monk-border bg-gradient-to-r from-monk-tealLight to-white">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="font-bold text-xl">Unit 2 — The Parser</h3>
                                <p class="text-monk-muted mt-1">Transform tokens into a tree. Understand grammar and precedence.</p>
                            </div>
                            <span class="tag text-monk-teal bg-white px-2 py-0.5 rounded-full border border-teal-200">5 lessons</span>
                        </div>
                    </div>
                    <div class="divide-y divide-monk-border">
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-tealLight flex items-center justify-center flex-shrink-0"><span class="text-monk-teal font-semibold text-sm">2.1</span></div><div class="flex-1"><h4 class="font-semibold text-sm">What Is a Parser?</h4><p class="text-monk-muted text-xs mt-0.5">Tokens in, tree out. The sentence diagrammer.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-tealLight flex items-center justify-center flex-shrink-0"><span class="text-monk-teal font-semibold text-sm">2.2</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Operator Precedence</h4><p class="text-monk-muted text-xs mt-0.5">Why 1+2*3 is 7, not 9. Pratt parsing visualized.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-tealLight flex items-center justify-center flex-shrink-0"><span class="text-monk-teal font-semibold text-sm">2.3</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Designing Monk's AST</h4><p class="text-monk-muted text-xs mt-0.5">Every node type. Expressions vs statements. The full tree.</p></div><TagBadge variant="monk">monk</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-tealLight flex items-center justify-center flex-shrink-0"><span class="text-monk-teal font-semibold text-sm">2.4</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Building the Parser</h4><p class="text-monk-muted text-xs mt-0.5">Recursive descent, one grammar rule at a time. TDD.</p></div><TagBadge variant="build">build</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-tealLight flex items-center justify-center flex-shrink-0"><span class="text-monk-teal font-semibold text-sm">2.5</span></div><div class="flex-1"><h4 class="font-semibold text-sm">References & Further Reading</h4><p class="text-monk-muted text-xs mt-0.5">Crafting Interpreters Ch. 5-8, Pratt parsing.</p></div><TagBadge variant="links">links</TagBadge></div>
                    </div>
                </div>
            </div>

            <!-- Unit 3: Runtime -->
            <div class="mb-10">
                <div class="flex items-center gap-2 mb-4">
                    <span class="tag text-monk-green bg-monk-greenLight px-2 py-0.5 rounded-full">Phase 3</span>
                    <span class="text-monk-muted text-sm">Build the runtime</span>
                </div>

                <div class="unit-card bg-white rounded-2xl border border-monk-border overflow-hidden">
                    <div class="p-6 border-b border-monk-border bg-gradient-to-r from-monk-greenLight to-white">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="font-bold text-xl">Unit 3 — The Runtime</h3>
                                <p class="text-monk-muted mt-1">Evaluate the tree. Values, scopes, functions, closures, errors.</p>
                            </div>
                            <span class="tag text-monk-green bg-white px-2 py-0.5 rounded-full border border-green-200">8 lessons</span>
                        </div>
                    </div>
                    <div class="divide-y divide-monk-border">
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.1</span></div><div class="flex-1"><h4 class="font-semibold text-sm">What Is an Interpreter?</h4><p class="text-monk-muted text-xs mt-0.5">Walking the tree, evaluating nodes, values bubbling up.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.2</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Values and Types in Memory</h4><p class="text-monk-muted text-xs mt-0.5">The MonkValue tagged union. Stack vs heap. Type tags.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.3</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Scopes and Environments</h4><p class="text-monk-muted text-xs mt-0.5">Scope chains, variable lookup, shadowing.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.4</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Functions and Closures</h4><p class="text-monk-muted text-xs mt-0.5">Function values, capture by copy, why create_counter works.</p></div><TagBadge variant="monk">monk</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.5</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Control Flow</h4><p class="text-monk-muted text-xs mt-0.5">If, while, for, break, continue, return as signals.</p></div><TagBadge variant="concepts">concepts</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.6</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Error Handling</h4><p class="text-monk-muted text-xs mt-0.5">Guard/against/throw. Save a checkpoint, jump back to it.</p></div><TagBadge variant="monk">monk</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.7</span></div><div class="flex-1"><h4 class="font-semibold text-sm">Value Semantics</h4><p class="text-monk-muted text-xs mt-0.5">Deep copy on assign. Deep const. Why everything copies.</p></div><TagBadge variant="monk">monk</TagBadge></div>
                        <div class="lesson-item flex items-center gap-4 px-6 py-4"><div class="w-8 h-8 rounded-full bg-monk-greenLight flex items-center justify-center flex-shrink-0"><span class="text-monk-green font-semibold text-sm">3.8</span></div><div class="flex-1"><h4 class="font-semibold text-sm">References</h4><p class="text-monk-muted text-xs mt-0.5">Crafting Interpreters Ch. 7-11.</p></div><TagBadge variant="links">links</TagBadge></div>
                    </div>
                </div>
            </div>

            <!-- Units 4-8: Locked -->
            <div class="mb-10">
                <div class="flex items-center gap-2 mb-4">
                    <span class="tag text-monk-muted bg-stone-100 px-2 py-0.5 rounded-full">Coming Up</span>
                    <span class="text-monk-muted text-sm">Built as you reach each phase</span>
                </div>

                <div class="grid gap-4">
                    <div class="unit-card locked bg-white rounded-2xl border border-monk-border p-6">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center flex-shrink-0"><span class="text-monk-locked font-bold">4</span></div>
                            <div class="flex-1"><h3 class="font-bold">Built-in Functions</h3><p class="text-monk-muted text-sm">Registering native functions. Math, strings, arrays, type checking.</p></div>
                            <span class="tag text-monk-locked bg-stone-100 px-2 py-0.5 rounded-full">3 lessons</span>
                        </div>
                    </div>
                    <div class="unit-card locked bg-white rounded-2xl border border-monk-border p-6">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center flex-shrink-0"><span class="text-monk-locked font-bold">5</span></div>
                            <div class="flex-1"><h3 class="font-bold">Type System</h3><p class="text-monk-muted text-sm">Type checking, inference, structural typing, optionals.</p></div>
                            <span class="tag text-monk-locked bg-stone-100 px-2 py-0.5 rounded-full">4 lessons</span>
                        </div>
                    </div>
                    <div class="unit-card locked bg-white rounded-2xl border border-monk-border p-6">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center flex-shrink-0"><span class="text-monk-locked font-bold">6</span></div>
                            <div class="flex-1"><h3 class="font-bold">Modules</h3><p class="text-monk-muted text-sm">File loading, imports, exports, scope isolation.</p></div>
                            <span class="tag text-monk-locked bg-stone-100 px-2 py-0.5 rounded-full">3 lessons</span>
                        </div>
                    </div>
